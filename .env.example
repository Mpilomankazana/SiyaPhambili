# PostgreSQL Database Credentials
POSTGRES_USER=siyaphambili_admin
POSTGRES_PASSWORD=hackathon_secret_2026
POSTGRES_DB=siyaphambili_db

# Full connection string used by both microservices
DATABASE_URL=postgresql://siyaphambili_admin:hackathon_secret_2026@siyaphambili_db:5432/siyaphambili_db

# pgAdmin Configuration (Access at http://localhost:5050)
PGADMIN_EMAIL=admin@siyaphambili.org
PGADMIN_PASSWORD=adminpassword

# JWT — MUST be identical across services/auth and services/core so
# Core can independently verify tokens issued by Auth (the Gateway
# does not validate tokens itself — see docs/architecture/network_diagram.md)
JWT_SECRET_KEY=replace-this-with-a-long-random-string-before-the-hackathon
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60
